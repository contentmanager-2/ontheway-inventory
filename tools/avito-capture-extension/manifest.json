{
  "manifest_version": 3,
  "name": "OnTheWay · Avito Capture",
  "version": "0.1.0",
  "description": "Собирает только уже показанные карточки со страницы профиля OnTheWay на Авито.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "OnTheWay · Avito Capture",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.avito.ru/brands/ontheway*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
